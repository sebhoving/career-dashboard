# Supabase (Auth + Postgres + Realtime). Leave blank to run on seeded local data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# GitHub REST v3. Classic PAT with public_repo + read:user scope. Server only.
GITHUB_TOKEN=
GITHUB_USERNAME=

# Optional third party DSA stats source. Falls back to the internal table.
LEETCODE_USERNAME=
